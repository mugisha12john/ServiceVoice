# Server only. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://app_user:password@your-neon-host/neondb?sslmode=verify-full
AUTH_SECRET=your-random-secret
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Set only behind a proxy that overwrites forwarded headers.
AUTH_TRUST_HOST=false
# SMTP provider credentials (verification and notification delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# S3-compatible PRIVATE bucket. Never enable public object access.
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# For development, select local; never put uploads under public/.
# Paid Render can use local with a persistent disk at PRIVATE_UPLOAD_DIR.
STORAGE_DRIVER=s3
PRIVATE_UPLOAD_DIR=.private-uploads
# Constant-time authenticated scheduled worker endpoint
CRON_SECRET=your-job-secret
